PORT=5000
NODE_ENV=development

# Prisma connection string (Localhost port mapping for docker db)
DATABASE_URL="postgresql://ffms_user:ffms_pass@localhost:5432/ffms_db?schema=public"
TEST_DATABASE_URL="postgresql://ffms_user:ffms_pass@localhost:5432/ffms_test_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
ACCESS_TOKEN_SECRET="your_super_secret_access_token_min_64_characters_long_1234567890abcdef"
REFRESH_TOKEN_SECRET="your_super_secret_refresh_token_min_64_characters_long_1234567890abcdef"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Cloudinary
CLOUDINARY_CLOUD_NAME="mock_cloud"
CLOUDINARY_API_KEY="mock_key"
CLOUDINARY_API_SECRET="mock_secret"

# Email (Nodemailer)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="mock_smtp_user"
SMTP_PASS="mock_smtp_pass"
EMAIL_FROM="noreply@ffms.com"

# Organization defaults
DEFAULT_SHIFT_START="09:00"
DEFAULT_SHIFT_END="18:00"
LATE_THRESHOLD_MINUTES=15
UPLOAD_PATH="uploads"